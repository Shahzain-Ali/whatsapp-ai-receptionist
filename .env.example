# Copy this file to `whatsapp_fte/.env` and fill in your own values.
# The agent, the webhook, and the Sheets client all read that single file.
# NEVER commit the real .env — it is git-ignored.

# --- Model (OpenAI via LiteLlm) ---
OPENAI_API_KEY=

# --- WhatsApp Cloud API (Meta Developer > WhatsApp > API Setup) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=

# --- Booking backend (Google Sheets) — REQUIRED ---
# Without these two, sheets_client raises "GOOGLE_SA_KEY_PATH / BOOKING_SHEET_ID
# missing in .env" and every booking/availability tool fails.
# Path to the service-account JSON key (keep it in .secrets/, never commit it).
GOOGLE_SA_KEY_PATH=.secrets/gsa-key.json
# The spreadsheet id from its URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
BOOKING_SHEET_ID=

# --- Human-in-the-loop (HITL) toggle ---
# false (default) = the AI books end-to-end and confirms the customer itself.
# true            = every booking stays PENDING until the owner replies YES/NO.
REQUIRE_APPROVAL=false

# --- Webhook: owner / booking-team WhatsApp number (HITL mode only) ---
# Number that receives booking approval requests and replies YES/NO.
# Must be a DIFFERENT verified test number than the customer's.
WHATSAPP_OWNER_NUMBER=

# --- adk web demo only (optional) ---
# adk web has no per-customer phone, so the booking tools fall back to this one.
# Set it to a number that already has a booking in the sheet to demo the guardrail.
DEMO_CUSTOMER_PHONE=

# --- Network workaround (optional) ---
# Set to 1 only if your network's IPv4 route to graph.facebook.com is broken
# (WhatsApp sends time out) but IPv6 works. Forces requests to use IPv6.
# Leave empty/unset on normal networks and in production.
FORCE_IPV6=

# --- Production tracing (optional; OpenTelemetry -> Langfuse) ---
# Leave these UNSET to disable tracing entirely (the app then behaves exactly as
# before). Use the TRACES-specific vars, not the generic OTEL_EXPORTER_OTLP_ENDPOINT:
# the generic one also switches on the metrics and logs exporters.
# EU region: https://cloud.langfuse.com/api/public/otel/v1/traces
# US region: https://us.cloud.langfuse.com/api/public/otel/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Basic auth. Paste the two Langfuse keys EXACTLY as the dashboard shows them —
# they already carry their pk-lf- / sk-lf- prefix, so do not add it again (doing so
# makes each key 48 chars instead of 42 and the endpoint answers 401):
#   echo -n "<PUBLIC_KEY>:<SECRET_KEY>" | base64
# The -n matters: a trailing newline breaks the token. Then set the value to:
#   Authorization=Basic <that_token>,x-langfuse-ingestion-version=4
# Keys are region-scoped — EU keys are rejected by the US host and vice versa.
OTEL_EXPORTER_OTLP_TRACES_HEADERS=
OTEL_SERVICE_NAME=whatsapp-fte-webhook
